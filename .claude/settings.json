{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .agents/hooks/rust-format.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/rust-check.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/rust-clippy.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/jscpd.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/lf.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run jscpd *)",
      "Bash(bun run lf *)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)"
    ]
  }
}
